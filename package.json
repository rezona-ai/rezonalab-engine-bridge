{
  "name": "rezonalab-engine-bridge",
  "version": "0.1.3",
  "private": true,
  "description": "Rezona Lab Engine Bridge: push generated assets from the web canvas straight into a running Cocos Creator / Unity project over localhost WebSocket.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core-ts",
    "packages/web-client",
    "packages/cocos"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build -w @rezonalab/engine-bridge-core -w @rezonalab/engine-bridge-web",
    "test": "npm run build -w @rezonalab/engine-bridge-core && vitest run",
    "test:unity": "node scripts/test-unity.mjs",
    "build:cocos": "npm run build -w @rezonalab/engine-bridge-core && node packages/cocos/scripts/build-zip.mjs",
    "dev:fake-engine": "npm run build -w @rezonalab/engine-bridge-core && node scripts/fake-engine.mjs",
    "gen:fixtures": "node protocol/scripts/gen-fixtures.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "typecheck": "node packages/core-ts/scripts/embed-schema.mjs && tsc -b packages/core-ts packages/web-client",
    "lint": "eslint packages --ext .ts",
    "break:verify": "node scripts/break-verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
